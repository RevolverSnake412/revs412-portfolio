---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { uiCopy } from '../../../i18n';

const copy = uiCopy('fr');
const base = import.meta.env.BASE_URL;
const work = (await getCollection('work', ({ data }) => data.published && Boolean(data.translations?.fr)))
  .map((entry) => ({ entry, translation: entry.data.translations!.fr! }))
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());
---
<BaseLayout locale="fr" alternatePath="work" title="Études de cas en infrastructure et réseau | revs412" description="Études de cas sur l’infrastructure réseau, l’accès distant sécurisé, l’administration système, l’automatisation, le déploiement, le dépannage, la récupération et la documentation technique.">
  <main class="shell page"><header class="page-header"><p class="eyebrow">études de cas</p><h1>Projets d’infrastructure, de réseau et d’opérations techniques.</h1><p>Études de cas sur l’infrastructure réseau, l’accès distant sécurisé, l’administration système, l’automatisation, le déploiement, le dépannage, la récupération et la documentation technique.</p></header>
    <section class="work-index-section"><div class="work-index">{work.map(({ entry, translation }) => <article class="work-index-entry"><h2>{translation.title}</h2><p class="work-index-meta">{translation.type} <span>· {entry.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'short' })}</span></p><p class="work-index-summary">{translation.summary}</p><a class="work-index-open" href={`${base}fr/work/${entry.data.slug}/`}>Ouvrir : voir le projet →</a></article>)}</div>{work.length === 0 && <p class="empty-state">{copy.translationPending}</p>}</section>
  </main>
</BaseLayout>
