---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.published && Boolean(data.translations?.fr));
  return notes.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, translation: entry.data.translations!.fr! } }));
}
const { entry, translation } = Astro.props;
const body = await marked.parse(translation.body);
const date = entry.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = entry.data.updated?.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout locale="fr" alternatePath={`notes/${entry.data.slug}`} title={translation.seoTitle ?? `${translation.title} · revs412`} description={translation.seoDescription ?? translation.summary}>
  <main class="shell page"><article class="detail">
    <header class="page-header"><p class="eyebrow">notes / {translation.category}</p><h1>{translation.title}</h1><div class="detail-meta"><span>{date}</span>{updated && <span>mis à jour le {updated}</span>}</div><p>{translation.summary}</p></header>
    {entry.data.cover && <img src={entry.data.cover} alt="" />}
    <div class="prose" set:html={body} />
    {entry.data.tags.length ? <ul class="tag-list" aria-label="Étiquettes">{entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}</ul> : null}
  </article></main>
</BaseLayout>
