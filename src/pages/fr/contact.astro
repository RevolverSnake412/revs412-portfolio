---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const settings = await getEntry('settings', 'site');
if (!settings) throw new Error('Missing settings/site.yaml');
const { contact } = settings.data;
const telegramUrl = contact.telegram ? `https://t.me/${contact.telegram.replace(/^@/, '')}` : undefined;
---
<BaseLayout locale="fr" alternatePath="contact" title="Contact · revs412" description="Prendre contact pour un travail technique concret et fiable.">
  <main class="shell page"><header class="page-header"><p class="eyebrow">ouvrir une conversation</p><h1>Contact</h1><p>Pour les outils métier, les systèmes, le dépannage, l’automatisation, le déploiement et la documentation.</p></header>
  <section class="contact-panel" aria-label="Coordonnées"><dl class="contact-list"><div><dt>e-mail :</dt><dd><a href={`mailto:${contact.email}`}>{contact.email} ↗</a></dd></div>{contact.discord && <div><dt>discord :</dt><dd>{contact.discordUrl ? <a href={contact.discordUrl} rel="noreferrer">{contact.discord} ↗</a> : contact.discord}</dd></div>}{contact.telegram && telegramUrl && <div><dt>telegram :</dt><dd><a href={telegramUrl} rel="noreferrer">{contact.telegram} ↗</a></dd></div>}{contact.github && <div><dt>github :</dt><dd><a href={contact.github} rel="noreferrer">RevolverSnake412 ↗</a></dd></div>}{contact.linkedin && <div><dt>linkedin :</dt><dd><a href={contact.linkedin} rel="noreferrer">revs412 ↗</a></dd></div>}<div><dt>CV :</dt><dd><a href={`${import.meta.env.BASE_URL}fr/resume/`}>voir le CV ↗</a></dd></div></dl><p class="contact-note">Disponible pour des missions techniques réfléchies.</p>{contact.location && <p class="contact-location">À distance / Maroc</p>}</section></main>
</BaseLayout>
