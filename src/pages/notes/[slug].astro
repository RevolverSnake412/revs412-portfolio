---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.published);
  return notes.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = entry.data.updated?.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={entry.data.seoTitle ?? `${entry.data.title} · revs412`} description={entry.data.seoDescription ?? entry.data.summary}>
  <main class="shell page"><article class="detail">
    <header class="page-header"><p class="eyebrow">notes / {entry.data.category}</p><h1>{entry.data.title}</h1><div class="detail-meta"><span>{date}</span>{updated && <span>updated {updated}</span>}</div><p>{entry.data.summary}</p></header>
    {entry.data.cover && <img src={entry.data.cover} alt="" />}
    <div class="prose"><Content /></div>
    {entry.data.tags.length ? <ul class="tag-list" aria-label="Tags">{entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}</ul> : null}
  </article></main>
</BaseLayout>
