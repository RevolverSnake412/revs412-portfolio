---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Software Engineering & Network Infrastructure Services | revs412" description="Independent software engineering, network infrastructure, automation, deployment, troubleshooting, and technical documentation for remote clients from Morocco." alternatePath="services">
  <main class="shell page services-page">
    <header class="page-header">
      <p class="eyebrow">remote / Morocco</p>
      <h1>Software engineering, network infrastructure, and technical delivery.</h1>
      <p>Independent technical work for teams that need business systems, dependable infrastructure, secure remote access, practical automation, and documentation that stays useful after handover.</p>
    </header>

    <section class="services-grid" aria-label="Technical service areas">
      <article class="service-card">
        <p class="eyebrow">01 / business systems</p>
        <h2>Business systems and integrations</h2>
        <p>Software foundations, product and inventory workflows, data migration direction, and integrations that make operational information easier to maintain and verify.</p>
        <nav class="service-links" aria-label="Related business systems work"><a href={`${base}work/gopc-business-website/`}>GOPC business website →</a><a href={`${base}work/odoo-product-inventory-integration/`}>Odoo product and inventory integration →</a><a href={`${base}notes/dolibarr-to-odoo-migration-tooling/`}>Dolibarr to Odoo migration tooling →</a></nav>
      </article>

      <article class="service-card">
        <p class="eyebrow">02 / infrastructure</p>
        <h2>Network infrastructure and secure remote access</h2>
        <p>Network design, WireGuard access workflows, OpenWrt administration, private service boundaries, and practical troubleshooting for systems that need to remain reachable and controlled.</p>
        <nav class="service-links" aria-label="Related infrastructure work"><a href={`${base}work/wireguard-admin-access-manager/`}>WireGuard admin access manager →</a><a href={`${base}notes/wireguard-remote-access-setup/`}>WireGuard remote access setup →</a><a href={`${base}notes/openwrt-home-network-setup/`}>OpenWrt network setup →</a></nav>
      </article>

      <article class="service-card">
        <p class="eyebrow">03 / delivery</p>
        <h2>Automation, deployment, troubleshooting, and documentation</h2>
        <p>Repeatable deployment workflows, technical investigation, recovery planning, and client-facing documentation that turns implementation details into decisions teams can use.</p>
        <nav class="service-links" aria-label="Related delivery work"><a href={`${base}work/client-facing-technical-documentation/`}>Client-facing technical documentation →</a><a href={`${base}notes/docker-deployment-scripts-for-small-services/`}>Docker deployment scripts →</a><a href={`${base}notes/pull-based-backup-replication-to-openwrt-storage/`}>Backup replication to OpenWrt storage →</a></nav>
      </article>
    </section>

    <section class="services-contact" aria-labelledby="services-contact-heading">
      <h2 id="services-contact-heading">Discuss a technical project</h2>
      <p>Available for considered software, infrastructure, network, automation, deployment, and documentation work.</p>
      <a href={`${base}contact/`}>Open a conversation →</a>
    </section>
  </main>
</BaseLayout>
