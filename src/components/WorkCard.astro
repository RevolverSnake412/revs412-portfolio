---
const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
const formattedDate = item.data.date.toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a class="card" href={`${base}work/${item.data.slug}`}>
  <p class="card-label">project · {formattedDate}</p>
  <h3>{item.data.title}</h3>
  <p>{item.data.summary}</p>
  <span class="card-footer">read case study →</span>
</a>
